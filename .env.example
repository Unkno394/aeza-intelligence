# Set DATABASE_URL to the existing PostgreSQL before running Compose.

# Database shared by Rust services and host commands.
# DATABASE_URL=postgres://user@127.0.0.1:55432/aeza_intelligence

# Host port of the web UI.
# FRONTEND_PORT=8080

# Enables the search interest collector (TrendsMCP).
# TRENDSMCP_API_KEY=

# Login for the web UI and the whole /api. Either way access is granted to
# active rows of public.admins: viewer reads, operator and superadmin may also
# change Risk Score settings. Sessions are stored in public.admin_sessions.
# PUBLIC_URL=http://127.0.0.1:8080   # the address users open; default uses FRONTEND_PORT
# SESSION_HOURS=12

# Password login without OIDC: emails and Argon2 password hashes in
# public.admins (scripts/auth_user.sh add). Keycloak is not needed.
# DEFAULT_AUTH=true
# With DEFAULT_AUTH: while no admin has a password yet, create a superadmin
# from LOCAL_ADMIN_USER / LOCAL_ADMIN_PASSWORD (16+ characters) at startup.
# Later changes to that admin are kept; the variables are not read again.
# ENABLE_DEFAULT_USER=true
# LOCAL_ADMIN_USER=admin
# LOCAL_ADMIN_PASSWORD=generate-a-unique-password-of-at-least-16-characters

# OIDC login (DEFAULT_AUTH=false) with any provider with discovery: Keycloak,
# Authentik, Zitadel, Google, ... Register the redirect URI
# <PUBLIC_URL>/api/auth/callback and the post-logout URI <PUBLIC_URL>/ there.
# Without OIDC_ISSUER the API uses the bundled Keycloak below.
# OIDC_ISSUER=https://id.example.com/realms/aeza
# OIDC_CLIENT_ID=aeza-intelligence
# OIDC_CLIENT_SECRET=          # leave empty for a public client (PKCE only)
# OIDC_SCOPES=openid email profile

# Bundled Keycloak, started only with the sso profile. Both passwords are read
# only when the keycloak volume is created. Generate them with:
#   openssl rand -base64 18
# COMPOSE_PROFILES=sso
# KEYCLOAK_ADMIN_PASSWORD=generate-a-unique-password
# SSO_USER_PASSWORD=generate-another-unique-password
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_PORT=8081
# KEYCLOAK_URL=http://127.0.0.1:8081   # the address browsers open Keycloak at

# Optional demo-stream Compose profile (synthetic clients only).
# DEMO_STREAM_INTERVAL_SECONDS=15
# DEMO_REPLAY_DAYS=60
# DEMO_REPLAY_DELAY_MS=200

# Development only: every request acts as superadmin.
# AUTH_DISABLED=true
