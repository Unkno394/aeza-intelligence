# Secrets only. Settings are in config.toml, ports in docker-compose.yml.
# Generate passwords with: openssl rand -base64 18

# PostgreSQL shared by the Rust services and the scripts.
DATABASE_URL=postgres://user:password@127.0.0.1:5432/aeza_intelligence

# Password of [auth.default_user] in config.toml, at least 16 characters.
# Read only while no admin has a password yet.
DEFAULT_USER_PASSWORD=

# auth.mode = "oidc": the password the OIDC provider issued to this application
# when it was registered there, if it issued one. The bundled Keycloak does
# not: its login is protected by PKCE alone.
# OIDC_CLIENT_SECRET=

# Bundled Keycloak (docker compose --profile sso). Both are read only when the
# keycloak volume is created.
# KEYCLOAK_ADMIN_PASSWORD=
# SSO_USER_PASSWORD=

# Enables the search interest collector (TrendsMCP).
# TRENDSMCP_API_KEY=
