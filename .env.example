# Optional: copy to .env to override defaults. `docker compose up` works without it.

# Database. By default compose runs its own `db` service with user, password and
# database all set to aeza. DATABASE_URL, if set, replaces the DB_* values entirely.
# Rust commands run on the host read DATABASE_URL only.
# DATABASE_URL=postgres://user@127.0.0.1:55432/aeza_intelligence
# DB_USER=aeza
# DB_PASSWORD=aeza
# DB_NAME=aeza
# DB_HOST=db
# DB_PORT=5432
# Host port the bundled database is published on.
# DB_PUBLISH_PORT=5433

# Host port of the web UI.
# FRONTEND_PORT=8080

# Enables the search interest collector (TrendsMCP).
TRENDSMCP_API_KEY=
