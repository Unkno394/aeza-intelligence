{
  "realm": "aeza",
  "enabled": true,
  "displayName": "Aéza Intelligence",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "clients": [
    {
      "clientId": "aeza-intelligence",
      "name": "Aéza Intelligence",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["${KC_AEZA_PUBLIC_URL}/api/auth/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${KC_AEZA_PUBLIC_URL}/"
      }
    }
  ],
  "users": [
    {
      "username": "analyst",
      "email": "analyst@aeza.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Aéza",
      "lastName": "Analyst",
      "credentials": [
        {"type": "password", "value": "${SSO_USER_PASSWORD}", "temporary": false}
      ]
    }
  ]
}
