{
  "openapi": "3.1.0",
  "info": {
    "title": "A\u00e9za Market Simulator",
    "version": "1.3.1",
    "description": "Primary v2 API uses RUB; v1 USD compatibility remains. The economic core bills in integer nano-RUB."
  },
  "paths": {
    "/api/market/v1/health": {
      "get": {
        "responses": {
          "200": {
            "description": "health"
          }
        }
      }
    },
    "/api/market/v1/catalog": {
      "get": {
        "responses": {
          "200": {
            "description": "catalog"
          }
        }
      }
    },
    "/api/market/v1/sources": {
      "get": {
        "responses": {
          "200": {
            "description": "sources"
          }
        }
      }
    },
    "/api/market/v1/example": {
      "get": {
        "responses": {
          "200": {
            "description": "example"
          }
        }
      }
    },
    "/api/market/v1/openapi.json": {
      "get": {
        "responses": {
          "200": {
            "description": "openapi.json"
          }
        }
      }
    },
    "/api/market/v1/simulate": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Scenario"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Report: echo scenario, hashes, warnings, runs and monthly provider metrics; see api.md"
          },
          "400": {
            "description": "Malformed JSON"
          },
          "413": {
            "description": "Body exceeds 128 KiB"
          },
          "422": {
            "description": "Invalid scenario or JSON shape"
          },
          "429": {
            "description": "Two workers busy"
          },
          "500": {
            "description": "Worker failed"
          }
        }
      }
    },
    "/api/market/v1/competition": {
      "post": {
        "summary": "Observed offer comparison, scenario simulation, decision/flow accounting and best submitted strategy",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "scenario",
                  "strategy",
                  "month",
                  "region"
                ],
                "properties": {
                  "scenario": {
                    "type": "object",
                    "description": "Same Scenario as /simulate, including optional market_events"
                  },
                  "strategy": {
                    "type": "string"
                  },
                  "month": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 24
                  },
                  "region": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Analysis: report, observed competitors with original and effective prices, resource/region eligibility, rankings, explanations, recommendations, limitations"
          },
          "422": {
            "description": "Invalid scenario or selected month/strategy"
          },
          "429": {
            "description": "Simulation capacity reached"
          }
        }
      }
    },
    "/api/market/v2/health": {
      "get": {
        "summary": "RUB health",
        "responses": {
          "200": {
            "description": "Verified snapshot-backed response; original price currencies retained in details"
          }
        }
      }
    },
    "/api/market/v2/catalog": {
      "get": {
        "summary": "RUB catalog",
        "responses": {
          "200": {
            "description": "Verified snapshot-backed response; original price currencies retained in details"
          }
        }
      }
    },
    "/api/market/v2/sources": {
      "get": {
        "summary": "RUB sources",
        "responses": {
          "200": {
            "description": "Verified snapshot-backed response; original price currencies retained in details"
          }
        }
      }
    },
    "/api/market/v2/example": {
      "get": {
        "summary": "RUB example",
        "responses": {
          "200": {
            "description": "Verified snapshot-backed response; original price currencies retained in details"
          }
        }
      }
    },
    "/api/market/v2/aeza-plans": {
      "get": {
        "summary": "RUB aeza-plans",
        "responses": {
          "200": {
            "description": "Verified snapshot-backed response; original price currencies retained in details"
          }
        }
      }
    },
    "/api/market/v2/contexts": {
      "get": {
        "summary": "RUB contexts",
        "responses": {
          "200": {
            "description": "Verified snapshot-backed response; original price currencies retained in details"
          }
        }
      }
    },
    "/api/market/v2/market-data": {
      "get": {
        "summary": "RUB market-data",
        "responses": {
          "200": {
            "description": "Verified snapshot-backed response; original price currencies retained in details"
          }
        }
      }
    },
    "/api/market/v2/simulate": {
      "post": {
        "summary": "RUB simulate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Scenario (or {scenario,strategy,month,region,verified_only}) with *_rub monetary fields; GET example for complete shape"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RUB report; exact nano-RUB ledger strings; fixed seed replay"
          },
          "422": {
            "description": "Invalid request or FX not matching verified snapshot"
          },
          "429": {
            "description": "Worker capacity reached"
          }
        }
      }
    },
    "/api/market/v2/competition": {
      "post": {
        "summary": "RUB competition",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Scenario (or {scenario,strategy,month,region,verified_only}) with *_rub monetary fields; GET example for complete shape"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RUB report; exact nano-RUB ledger strings; fixed seed replay"
          },
          "422": {
            "description": "Invalid request or FX not matching verified snapshot"
          },
          "429": {
            "description": "Worker capacity reached"
          }
        }
      }
    },
    "/api/market/v2/behavior": {
      "post": {
        "summary": "Buyer census and four paired RUB price replays",
        "description": "Body: {scenario: RUB v2 Scenario, strategy: existing name, sensitivity: low|medium|high}. Control, -20%, -10%, +15% relative price multipliers. Returns report, candidates with segment effects, recommendation, diagnostic_actions and limitations. Shared aggregate workload cap, trusted FX and two worker slots apply.",
        "responses": {
          "200": {
            "description": "RUB report with full census, exact profit ranking and price replays"
          },
          "422": {
            "description": "Invalid inputs or workload"
          },
          "429": {
            "description": "Worker slots occupied"
          }
        }
      }
    },
    "/api/market/v2/statistics": {
      "post": {
        "summary": "Recompute 100 paired seeds (0..99), profit ranges, risk and leadership",
        "description": "Body {scenario: RUB v2 Scenario,sensitivity: low|medium|high}. Fixed snapshot and inputs. No mean profit field. Wilson 95% intervals; explicit sole/tied wins; per-seed exact profits. One batch at a time; 750M aggregate bound.",
        "responses": {
          "200": {
            "description": "Empirical statistics and 100 raw points per strategy"
          },
          "422": {
            "description": "Invalid input, FX or workload"
          },
          "429": {
            "description": "Statistics or simulation capacity occupied"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Plan": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "provider",
          "name",
          "vcpu",
          "ram_gb",
          "disk_gb",
          "monthly_usd",
          "regions",
          "origin",
          "source",
          "observed_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "vcpu": {
            "type": "number"
          },
          "ram_gb": {
            "type": "number"
          },
          "disk_gb": {
            "type": "number"
          },
          "monthly_usd": {
            "type": "number"
          },
          "regions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "origin": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "observed_at": {
            "type": "string"
          }
        }
      },
      "Segment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "weight",
          "budget_min",
          "budget_max",
          "vcpu",
          "ram_gb",
          "disk_gb",
          "region"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "weight": {
            "type": "number"
          },
          "budget_min": {
            "type": "number"
          },
          "budget_max": {
            "type": "number"
          },
          "vcpu": {
            "type": "number"
          },
          "ram_gb": {
            "type": "number"
          },
          "disk_gb": {
            "type": "number"
          },
          "region": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Strategy": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "aeza_price_multipliers"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "aeza_price_multipliers": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        }
      },
      "ModelOutput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "model_version",
          "source",
          "schema_version",
          "semantics",
          "monthly_departure_probability"
        ],
        "properties": {
          "slot": {
            "enum": [
              "snapshot",
              "historical"
            ]
          },
          "model_version": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "schema_version": {
            "const": 1
          },
          "semantics": {
            "const": "calibrated_monthly_departure_probability"
          },
          "monthly_departure_probability": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        }
      },
      "Scenario": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "seed",
          "months",
          "buyers_per_month",
          "arrival_weights",
          "segments",
          "aeza_plans",
          "strategies",
          "sensitivities",
          "monthly_departure_probability",
          "switching_cost_utility",
          "outside_option_utility",
          "preference_strength",
          "aeza_variable_cost_usd",
          "aeza_fixed_cost_usd",
          "external_models"
        ],
        "properties": {
          "seed": {
            "type": "integer",
            "minimum": 0
          },
          "months": {
            "type": "integer",
            "minimum": 0
          },
          "buyers_per_month": {
            "type": "integer",
            "minimum": 0
          },
          "arrival_weights": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "segments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Segment"
            }
          },
          "aeza_plans": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Plan"
            }
          },
          "strategies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Strategy"
            }
          },
          "sensitivities": {
            "type": "array",
            "items": {
              "enum": [
                "low",
                "medium",
                "high"
              ]
            }
          },
          "monthly_departure_probability": {
            "type": "number"
          },
          "switching_cost_utility": {
            "type": "number"
          },
          "outside_option_utility": {
            "type": "number"
          },
          "preference_strength": {
            "type": "number"
          },
          "aeza_variable_cost_usd": {
            "type": "number"
          },
          "aeza_fixed_cost_usd": {
            "type": "number"
          },
          "external_models": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelOutput"
            }
          }
        }
      }
    }
  }
}
