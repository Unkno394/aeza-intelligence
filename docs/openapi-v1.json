{
  "openapi": "3.0.3",
  "info": {"title": "Aeza Intelligence API", "version": "1.0.0"},
  "paths": {
    "/api/v1/auth/login": {"post": {"summary": "Password login of a public.admins row", "description": "Available with auth.mode = \"password\" in config.toml. The username is the admin's email, compared case-insensitively.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Credentials"}}}}, "responses": {"204": {"description": "Session cookie set"}, "401": {"description": "Invalid credentials"}, "403": {"description": "Origin header of another site"}, "404": {"description": "auth.mode is not \"password\""}}}},
    "/api/v1/auth/me": {"get": {"summary": "Current administrator", "security": [{"sessionCookie": []}], "responses": {"200": {"description": "Administrator", "content": {"application/json": {"schema": {"type": "object"}}}}, "401": {"description": "No session"}}}},
    "/api/v1/auth/logout": {"post": {"summary": "End session", "responses": {"200": {"description": "Session ended"}}}},
    "/api/v1/customers": {"get": {"summary": "Customers and risk scores", "security": [{"sessionCookie": []}], "parameters": [{"name": "search", "in": "query", "schema": {"type": "string"}}, {"name": "risk", "in": "query", "schema": {"type": "string", "enum": ["all", "high", "medium", "low", "limited", "insufficient"]}}, {"name": "sort", "in": "query", "schema": {"type": "string", "enum": ["id", "email", "balance", "totalReplenished", "score"]}}, {"name": "direction", "in": "query", "schema": {"type": "string", "enum": ["asc", "desc"]}}, {"name": "page", "in": "query", "schema": {"type": "integer", "minimum": 1}}, {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 500}}], "responses": {"200": {"description": "Paginated list", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CustomerPage"}}}}, "400": {"description": "Invalid query"}, "401": {"description": "No session"}}}},
    "/api/v1/customers/{id}": {"get": {"summary": "Customer, services and risk factors", "security": [{"sessionCookie": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Customer details", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CustomerDetail"}}}}, "401": {"description": "No session"}, "404": {"description": "Customer absent"}}}},
    "/api/v1/analytics/summary": {"get": {"summary": "Risk counts and distinct financial measures in euro cents", "security": [{"sessionCookie": []}], "responses": {"200": {"description": "Current summary", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Summary"}}}}, "401": {"description": "No session"}}}},
    "/api/v1/model/settings": {"get": {"summary": "Saved model settings", "security": [{"sessionCookie": []}], "responses": {"200": {"description": "Settings", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SettingsResponse"}}}}, "401": {"description": "No session"}}}, "patch": {"summary": "Save settings and recalculate risk", "security": [{"sessionCookie": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Settings"}}}}, "responses": {"200": {"description": "Updated settings"}, "400": {"description": "Invalid weights or thresholds"}, "401": {"description": "No session"}, "403": {"description": "Insufficient role"}}}},
    "/api/v1/source/snapshot": {"put": {"summary": "Atomically replace the source snapshot", "description": "Validates the complete snapshot, then replaces accounts, services and transactions in one PostgreSQL transaction. The previous snapshot remains intact if any delete or insert fails.", "security": [{"sessionCookie": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["accounts", "services", "transactions"], "properties": {"accounts": {"type": "array", "items": {"type": "object"}}, "services": {"type": "array", "items": {"type": "object"}}, "transactions": {"type": "array", "items": {"type": "object"}}}}}}}, "responses": {"200": {"description": "Replacement counts"}, "400": {"description": "Invalid snapshot or replacement rejected"}, "401": {"description": "No session"}, "403": {"description": "Insufficient role"}}}},
    "/metrics": {"get": {"summary": "Prometheus metrics", "responses": {"200": {"description": "Text exposition format", "content": {"text/plain": {"schema": {"type": "string"}}}}}}},
    "/api/v1/docs": {"get": {"summary": "Swagger UI", "responses": {"200": {"description": "HTML documentation"}}}},
    "/api/v1/openapi.json": {"get": {"summary": "OpenAPI specification", "responses": {"200": {"description": "OpenAPI JSON"}}}}
  },
  "components": {"securitySchemes": {"sessionCookie": {"type": "apiKey", "in": "cookie", "name": "aeza_session"}}, "schemas": {
    "Credentials": {"type": "object", "required": ["username", "password"], "properties": {"username": {"type": "string"}, "password": {"type": "string", "format": "password"}}},
    "CustomerPage": {"type": "object", "required": ["items", "total", "page", "limit"], "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/CustomerDetail"}}, "total": {"type": "integer"}, "page": {"type": "integer"}, "limit": {"type": "integer"}}},
    "CustomerDetail": {"type": "object", "properties": {"account": {"type": "object"}, "services": {"type": "array", "items": {"$ref": "#/components/schemas/Service"}}, "transactions": {"type": "array", "items": {"$ref": "#/components/schemas/Transaction"}}, "risk": {"type": "object"}}},
    "Service": {"type": "object", "required": ["id", "ownerId", "paymentTerm", "autoProlong", "status", "price"], "properties": {"id": {"type": "integer", "format": "int64"}, "ownerId": {"type": "integer", "format": "int64"}, "paymentTerm": {"type": "string", "enum": ["hour", "week", "month", "quarter_year", "half_year", "year"]}, "autoProlong": {"type": "boolean"}, "status": {"type": "string", "enum": ["active", "suspended", "prolong_wait", "deleted", "blocked"]}, "price": {"type": "integer", "format": "int64"}}},
    "Transaction": {"type": "object", "required": ["id", "serviceId", "amount", "status", "type"], "properties": {"id": {"type": "integer", "format": "int64"}, "serviceId": {"type": "integer", "format": "int64"}, "amount": {"type": "integer"}, "status": {"type": "string", "enum": ["performed", "not_performed"]}, "type": {"type": "string", "enum": ["prolong", "order"]}}},
    "Summary": {"type": "object", "description": "Financial values are euro cents. The 30-day expected-loss field is an explicit score-weighted gross-revenue scenario, not a calibrated churn probability or profit estimate.", "properties": {"customersTotal": {"type": "integer"}, "customersByRisk": {"type": "object", "additionalProperties": {"type": "integer"}}, "revenueAtRiskEurCents": {"type": "integer", "description": "Monthly active and suspended service revenue for high-risk customers."}, "paymentDeficitEurCents": {"type": "integer", "description": "Current shortfall against upcoming payments, reported separately from expected revenue loss."}, "expectedLossEurCents": {"type": "integer", "description": "For customers with sufficient data: round(monthly active and suspended service revenue × Risk Score / 100), summed per customer."}, "expectedLossHorizonDays": {"type": "integer", "enum": [30]}, "expectedLossAssessedMonthlyRevenueEurCents": {"type": "integer", "description": "Monthly revenue included in the scenario estimate."}, "expectedLossUnassessedMonthlyRevenueEurCents": {"type": "integer", "description": "Monthly revenue excluded because the risk assessment has incomplete data."}, "expectedLossUnassessedCustomers": {"type": "integer", "description": "Visible customers whose risk assessment is limited or insufficient, including customers with no recurring revenue."}, "expectedLossMethod": {"type": "string", "enum": ["risk_score_weighted_monthly_revenue_v1"]}, "expectedLossDefinition": {"type": "string"}, "lastCalculatedAt": {"type": "string", "format": "date-time"}}},
    "Settings": {"type": "object", "required": ["weights", "mediumThreshold", "highThreshold", "renewalWindowDays", "historicalMinDays"], "properties": {"weights": {"type": "object"}, "mediumThreshold": {"type": "integer"}, "highThreshold": {"type": "integer"}, "renewalWindowDays": {"type": "integer"}, "historicalMinDays": {"type": "integer"}}},
    "SettingsResponse": {"type": "object", "properties": {"settings": {"$ref": "#/components/schemas/Settings"}, "metadata": {"type": "object"}}}
  }}
}
